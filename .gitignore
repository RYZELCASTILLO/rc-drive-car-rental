@"
# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# PHP error logs
*.log
error_log

# Database configuration (if you have sensitive info)
# config.php

# Temporary files
*.tmp
*.temp

# Backup files
*.bak
*.backup

# Composer
vendor/
composer.lock

# Node modules
node_modules/
"@ | Out-File -FilePath .\.gitignore -Encoding utf8